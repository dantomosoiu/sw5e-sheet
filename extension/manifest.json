{
  "manifest_version": 3,
  "name": "SW5E Character Sheet Viewer",
  "short_name": "SW5E Sheet",
  "version": "0.2.0",
  "description": "A single-page, comprehensive view of your SW5E characters — loaded from sw5e.com or imported from a file.",
  "permissions": ["storage", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://sw5e.com/*", "https://www.sw5e.com/*"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "action": {
    "default_title": "Open SW5E character sheet",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
