# The sheet server's settings (server/server.js, loadConfig). deploy/setup.sh copies this to /etc/sw5e-sheet.env
# (readable by root and the service only): edit it there, then `sudo systemctl restart sw5e-sheet`.

# The address players use. With a domain: https://sheet.example.com (Caddy gets its certificate by itself).
# Before there's a domain: http://<the droplet's IP> (no HTTPS: test only, passwords cross the network readable).
PUBLIC_URL=http://203.0.113.10

# Where the database lives (the service may write only here).
DATA_DIR=/var/lib/sw5e-sheet

# Caddy is in front: the server listens on this machine only, and reads the player's address from Caddy.
HOST=127.0.0.1
PORT=8780
TRUST_PROXY=true

# Google sign-in (optional; docs/server.md says how to get these). Without them, only e-mail and password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "false" closes new accounts; existing ones still sign in.
ALLOW_SIGNUP=true

# Limits per account.
MAX_CHARACTERS=300
MAX_ACCOUNT_MB=300
MAX_CHARACTER_MB=15
